{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 2,
  "trailingComma": "none",
  "semi": true,
  "singleQuote": true,
  "printWidth": 120,
  "sortPackageJson": false,
  "ignorePatterns": [
    "poc/**",
    "**/generated/**",
    "**/worker-configuration.d.ts",
    "apps/server/openapi.json",
    "apps/server/drizzle/**",
    "*.md",
    "apps/demo/seed/**"
  ]
}
