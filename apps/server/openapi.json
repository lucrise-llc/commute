{
  "openapi": "3.1.0",
  "info": {
    "title": "Commute API",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {
      "ChangeEvent": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/OverlapFoundEvent"
          },
          {
            "$ref": "#/components/schemas/MergeCheckedEvent"
          },
          {
            "$ref": "#/components/schemas/LandedEvent"
          },
          {
            "$ref": "#/components/schemas/RestackedEvent"
          },
          {
            "$ref": "#/components/schemas/RestackConflictEvent"
          },
          {
            "$ref": "#/components/schemas/ChecksDoneEvent"
          },
          {
            "$ref": "#/components/schemas/LandingFailedEvent"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "overlap_found": "#/components/schemas/OverlapFoundEvent",
            "merge_checked": "#/components/schemas/MergeCheckedEvent",
            "landed": "#/components/schemas/LandedEvent",
            "restacked": "#/components/schemas/RestackedEvent",
            "restack_conflict": "#/components/schemas/RestackConflictEvent",
            "checks_done": "#/components/schemas/ChecksDoneEvent",
            "landing_failed": "#/components/schemas/LandingFailedEvent"
          }
        }
      },
      "OverlapFoundEvent": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer"
          },
          "type": {
            "type": "string",
            "enum": [
              "overlap_found"
            ]
          },
          "changeId": {
            "type": "string",
            "pattern": "^c-[1-9][0-9]{0,8}$",
            "example": "c-157"
          },
          "at": {
            "type": "string"
          },
          "overlap": {
            "$ref": "#/components/schemas/Overlap"
          }
        },
        "required": [
          "seq",
          "type",
          "changeId",
          "at",
          "overlap"
        ]
      },
      "Overlap": {
        "type": "object",
        "properties": {
          "changeId": {
            "type": "string",
            "pattern": "^c-[1-9][0-9]{0,8}$",
            "example": "c-157"
          },
          "intent": {
            "type": "string"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "otherPath": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "otherPath"
              ]
            }
          }
        },
        "required": [
          "changeId",
          "intent",
          "paths"
        ]
      },
      "MergeCheckedEvent": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer"
          },
          "type": {
            "type": "string",
            "enum": [
              "merge_checked"
            ]
          },
          "changeId": {
            "type": "string",
            "pattern": "^c-[1-9][0-9]{0,8}$",
            "example": "c-157"
          },
          "at": {
            "type": "string"
          },
          "otherChange": {
            "type": "object",
            "properties": {
              "changeId": {
                "type": "string",
                "pattern": "^c-[1-9][0-9]{0,8}$",
                "example": "c-157"
              },
              "intent": {
                "type": "string"
              }
            },
            "required": [
              "changeId",
              "intent"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "parallel",
              "sequenced"
            ]
          },
          "landsFirst": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^c-[1-9][0-9]{0,8}$",
            "example": "c-157"
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "seq",
          "type",
          "changeId",
          "at",
          "otherChange",
          "outcome",
          "landsFirst",
          "conflicts"
        ]
      },
      "LandedEvent": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer"
          },
          "type": {
            "type": "string",
            "enum": [
              "landed"
            ]
          },
          "changeId": {
            "type": "string",
            "pattern": "^c-[1-9][0-9]{0,8}$",
            "example": "c-157"
          },
          "at": {
            "type": "string"
          },
          "batchId": {
            "type": "string",
            "pattern": "^b-[1-9][0-9]{0,8}$",
            "example": "b-12"
          },
          "landedCommit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "approver": {
            "type": "string"
          }
        },
        "required": [
          "seq",
          "type",
          "changeId",
          "at",
          "batchId",
          "landedCommit",
          "approver"
        ]
      },
      "RestackedEvent": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer"
          },
          "type": {
            "type": "string",
            "enum": [
              "restacked"
            ]
          },
          "changeId": {
            "type": "string",
            "pattern": "^c-[1-9][0-9]{0,8}$",
            "example": "c-157"
          },
          "at": {
            "type": "string"
          },
          "trunkCommit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "headCommit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "required": [
          "seq",
          "type",
          "changeId",
          "at",
          "trunkCommit",
          "headCommit"
        ]
      },
      "RestackConflictEvent": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer"
          },
          "type": {
            "type": "string",
            "enum": [
              "restack_conflict"
            ]
          },
          "changeId": {
            "type": "string",
            "pattern": "^c-[1-9][0-9]{0,8}$",
            "example": "c-157"
          },
          "at": {
            "type": "string"
          },
          "trunkCommit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "seq",
          "type",
          "changeId",
          "at",
          "trunkCommit",
          "conflicts"
        ]
      },
      "ChecksDoneEvent": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer"
          },
          "type": {
            "type": "string",
            "enum": [
              "checks_done"
            ]
          },
          "changeId": {
            "type": "string",
            "pattern": "^c-[1-9][0-9]{0,8}$",
            "example": "c-157"
          },
          "at": {
            "type": "string"
          },
          "kept": {
            "type": "integer"
          },
          "ran": {
            "type": "integer"
          },
          "failed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "seq",
          "type",
          "changeId",
          "at",
          "kept",
          "ran",
          "failed"
        ]
      },
      "LandingFailedEvent": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer"
          },
          "type": {
            "type": "string",
            "enum": [
              "landing_failed"
            ]
          },
          "changeId": {
            "type": "string",
            "pattern": "^c-[1-9][0-9]{0,8}$",
            "example": "c-157"
          },
          "at": {
            "type": "string"
          },
          "batchId": {
            "type": "string",
            "pattern": "^b-[1-9][0-9]{0,8}$",
            "example": "b-12"
          }
        },
        "required": [
          "seq",
          "type",
          "changeId",
          "at",
          "batchId"
        ]
      },
      "WaitRequest": {
        "type": "object",
        "properties": {
          "after": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "after"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ProjectCreated": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,38}[a-z0-9]$",
            "example": "storefront"
          },
          "remote": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "tokenExpiresAt": {
            "type": "string"
          }
        },
        "required": [
          "projectId",
          "remote",
          "token",
          "tokenExpiresAt"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message"
              ]
            }
          }
        },
        "required": [
          "error"
        ]
      },
      "CreateProjectBody": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,38}[a-z0-9]$",
            "example": "storefront"
          }
        },
        "required": [
          "projectId"
        ]
      },
      "ChangeStarted": {
        "type": "object",
        "properties": {
          "changeId": {
            "type": "string",
            "pattern": "^c-[1-9][0-9]{0,8}$",
            "example": "c-157"
          },
          "remote": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "tokenExpiresAt": {
            "type": "string"
          },
          "baseCommit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "overlaps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Overlap"
            }
          }
        },
        "required": [
          "changeId",
          "remote",
          "token",
          "tokenExpiresAt",
          "baseCommit",
          "overlaps"
        ]
      },
      "StartChangeBody": {
        "type": "object",
        "properties": {
          "intent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^[^\\p{Cc}]+$/u"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "example": "src/cart/pricing.ts"
            },
            "minItems": 1,
            "maxItems": 100
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^\\p{Cc}]+$/u",
            "example": "alice"
          }
        },
        "required": [
          "intent",
          "paths"
        ]
      },
      "Change": {
        "type": "object",
        "properties": {
          "changeId": {
            "type": "string",
            "pattern": "^c-[1-9][0-9]{0,8}$",
            "example": "c-157"
          },
          "intent": {
            "type": "string"
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "landing",
              "landed"
            ]
          },
          "baseCommit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "headCommit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "declaredPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "footprint": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "overlaps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Overlap"
            }
          },
          "landsAfter": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^c-[1-9][0-9]{0,8}$",
              "example": "c-157"
            }
          },
          "landsBefore": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^c-[1-9][0-9]{0,8}$",
              "example": "c-157"
            }
          },
          "waitsFor": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WaitReason"
            }
          },
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChangeCheck"
            }
          },
          "checksError": {
            "type": [
              "string",
              "null"
            ]
          },
          "batchId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^b-[1-9][0-9]{0,8}$",
            "example": "b-12"
          },
          "landedCommit": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{40}$"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "changeId",
          "intent",
          "owner",
          "state",
          "baseCommit",
          "headCommit",
          "declaredPaths",
          "footprint",
          "overlaps",
          "landsAfter",
          "landsBefore",
          "waitsFor",
          "checks",
          "checksError",
          "batchId",
          "landedCommit",
          "createdAt"
        ]
      },
      "WaitReason": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "NO_COMMITS",
              "RESTACKING",
              "RESTACK_CONFLICT",
              "LANDS_AFTER",
              "CHECKING",
              "CHECKS_PENDING",
              "CHECKS_INVALID",
              "CHECKS_FAILED",
              "LANDING"
            ]
          },
          "changeIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^c-[1-9][0-9]{0,8}$",
              "example": "c-157"
            }
          }
        },
        "required": [
          "code",
          "changeIds"
        ]
      },
      "ChangeCheck": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "pending",
              "pass",
              "fail"
            ]
          },
          "kept": {
            "type": "boolean"
          },
          "reads": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "previousReads": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "exitCode": {
            "type": [
              "integer",
              "null"
            ]
          },
          "output": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "outcome",
          "kept",
          "reads",
          "previousReads",
          "exitCode",
          "output"
        ]
      },
      "Landing": {
        "type": "object",
        "properties": {
          "trunkHead": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{40}$"
          },
          "ready": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "changeId": {
                  "type": "string",
                  "pattern": "^c-[1-9][0-9]{0,8}$",
                  "example": "c-157"
                },
                "intent": {
                  "type": "string"
                },
                "owner": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "changeId",
                "intent",
                "owner"
              ]
            }
          },
          "waiting": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "changeId": {
                  "type": "string",
                  "pattern": "^c-[1-9][0-9]{0,8}$",
                  "example": "c-157"
                },
                "intent": {
                  "type": "string"
                },
                "owner": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "waitsFor": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WaitReason"
                  }
                }
              },
              "required": [
                "changeId",
                "intent",
                "owner",
                "waitsFor"
              ]
            }
          },
          "batch": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "batchId": {
                "type": "string",
                "pattern": "^b-[1-9][0-9]{0,8}$",
                "example": "b-12"
              },
              "changeIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^c-[1-9][0-9]{0,8}$",
                  "example": "c-157"
                }
              },
              "approver": {
                "type": "string"
              }
            },
            "required": [
              "batchId",
              "changeIds",
              "approver"
            ]
          }
        },
        "required": [
          "trunkHead",
          "ready",
          "waiting",
          "batch"
        ]
      },
      "BatchApproved": {
        "type": "object",
        "properties": {
          "batchId": {
            "type": "string",
            "pattern": "^b-[1-9][0-9]{0,8}$",
            "example": "b-12"
          }
        },
        "required": [
          "batchId"
        ]
      },
      "ApproveBatchBody": {
        "type": "object",
        "properties": {
          "changeIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^c-[1-9][0-9]{0,8}$",
              "example": "c-157"
            },
            "minItems": 1,
            "maxItems": 50
          },
          "approver": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^\\p{Cc}]+$/u",
            "example": "alice"
          }
        },
        "required": [
          "changeIds",
          "approver"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "The Worker serves requests.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects": {
      "post": {
        "operationId": "createProject",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProjectBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The project exists with an empty trunk. The token lets the owner push the first commit to trunk.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectCreated"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST: the body does not match the schema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "PROJECT_EXISTS: a project with this ID exists.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/{projectId}/changes": {
      "post": {
        "operationId": "startChange",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,38}[a-z0-9]$",
              "example": "storefront"
            },
            "required": true,
            "name": "projectId",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartChangeBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The change has its own repository, forked from trunk. The response lists the changes in flight whose footprints meet the declared paths.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangeStarted"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST: the body does not match the schema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "PROJECT_NOT_FOUND: no project has this ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "TRUNK_EMPTY: trunk has no commit to fork from.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "FORK_FAILED: Artifacts could not fork trunk.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/{projectId}/changes/{changeId}": {
      "get": {
        "operationId": "getChange",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,38}[a-z0-9]$",
              "example": "storefront"
            },
            "required": true,
            "name": "projectId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^c-[1-9][0-9]{0,8}$",
              "example": "c-157"
            },
            "required": true,
            "name": "changeId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The change as the coordinator knows it: its head, its footprint, and its overlaps.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Change"
                }
              }
            }
          },
          "404": {
            "description": "CHANGE_NOT_FOUND: the project has no open change with this ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/{projectId}/landing": {
      "get": {
        "operationId": "getLanding",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,38}[a-z0-9]$",
              "example": "storefront"
            },
            "required": true,
            "name": "projectId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The changes ready to land as the next batch, the changes that wait and why, and the batch that is landing.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Landing"
                }
              }
            }
          },
          "404": {
            "description": "PROJECT_NOT_FOUND: no project has this ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/{projectId}/batches": {
      "post": {
        "operationId": "approveBatch",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,38}[a-z0-9]$",
              "example": "storefront"
            },
            "required": true,
            "name": "projectId",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApproveBatchBody"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "The batch lands in the background. Each change gets a landed event, then the others restack.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchApproved"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST: the body does not match the schema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "PROJECT_NOT_FOUND: no project has this ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "BATCH_NOT_READY: a change is not ready. LANDING_IN_PROGRESS: another batch is landing.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
