{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "commute",
  "account_id": "ef2e81e746f2503a8ca3fa19fd88ba30",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../console/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/git/*"]
  },
  "observability": {
    "enabled": true
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql"],
      "fallthrough": true
    }
  ],
  "vars": {
    "ARTIFACTS_GIT_ORIGIN": "https://ef2e81e746f2503a8ca3fa19fd88ba30.artifacts.cloudflare.net/git/commute-dev"
  },
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "commute-dev",
      "remote": true
    }
  ],
  "containers": [
    {
      "class_name": "Runner",
      "image": "./runner/Dockerfile",
      "instance_type": "basic",
      "max_instances": 20
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COORDINATOR",
        "class_name": "Coordinator"
      },
      {
        "name": "RUNNER",
        "class_name": "Runner"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Coordinator"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Runner"]
    }
  ]
}
